PORT=4000

# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never ship to the frontend

# The mock store
STORE_BASE_URL=https://demo.inelabteamdev.com

# Shared secret the external cron job must send to trigger a scrape.
# Configure cron-job.org to POST to:
#   https://your-backend.onrender.com/api/scrape/run?token=THIS_VALUE
# every 2 hours.
CRON_SECRET=choose-a-long-random-string

# Set to false only when running `npm run scrape:headed` locally for the
# screen-recording deliverable. Leave true (or unset) in production.
HEADLESS=true
